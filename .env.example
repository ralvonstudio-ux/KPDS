# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# --- Supabase (public, safe for the browser bundle) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Razorpay (public key id only — safe for the browser) ---
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- Server-side only (Supabase Edge Function secrets, NOT prefixed with VITE_) ---
# Set these with `supabase secrets set NAME=value`, never in this file for production.
# SUPABASE_SERVICE_ROLE_KEY=...
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
